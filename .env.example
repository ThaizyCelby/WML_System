# ──────────────────────────────────────────────
# DJANGO CORE
# ──────────────────────────────────────────────
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ──────────────────────────────────────────────
# SITE / BRANDING
# ──────────────────────────────────────────────
SITE_NAME=Wethu Micro Lenders
SITE_SHORT_NAME=Wethu
SITE_DESCRIPTION=Responsible micro-lending, powered by financial intelligence.
SITE_SUPPORT_EMAIL=support@wethumicrolenders.co.za
SITE_SUPPORT_PHONE=+27 10 000 0000
SITE_COMPANY_REG=NCRCP-XXXXX

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=wethu_micro_lenders
DB_USER=wethu_micro_lenders
DB_PASSWORD=change-me-to-secure-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ──────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
SESSION_REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ──────────────────────────────────────────────
# CORS & CSRF
# ──────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ──────────────────────────────────────────────
# FINANCIAL CONFIGURATION
# ──────────────────────────────────────────────
DEFAULT_INTEREST_RATE=30.00
INTEREST_RATE_MIN=0.00
INTEREST_RATE_MAX=36.00
LATE_PAYMENT_FEE=50.00
ORIGINATION_FEE_PERCENT=2.50

# ──────────────────────────────────────────────
# AI PROVIDERS
# ──────────────────────────────────────────────

#OPENAI_ENABLED=false
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

#GEMINI_ENABLED=true
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash

GLM_ENABLED=true
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

AI_DEFAULT_PROVIDER=glm
AI_FALLBACK_TO_MOCK=true

# ──────────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=givenyprincey@gmail.com
EMAIL_HOST_PASSWORD=Thokozani1*2
DEFAULT_FROM_EMAIL=givenyprincey@gmail.com
SERVER_EMAIL=givenyprincey@gmail.com

# ──────────────────────────────────────────────
# SECURITY ALERTS
# ──────────────────────────────────────────────
SECURITY_ALERT_RECIPIENTS=givenyprincey@gmail.com
DEVELOPER_EMAIL=givenyprincey@gmail.com

# ──────────────────────────────────────────────
# SMS (Twilio - optional)
# ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ──────────────────────────────────────────────
# PAYMENT PROVIDER
# ──────────────────────────────────────────────
PAYMENT_PROVIDER=mock
NUPAY_ENDPOINT=
NUPAY_API_KEY=
NUPAY_API_SECRET=
NUPAY_MERCHANT_ID=
NUPAY_WEBHOOK_SECRET=
NUPAY_TIMEOUT=30
NUPAY_RETRIES=3
NUPAY_WEBHOOK_TOLERANCE_SEC=300

# ──────────────────────────────────────────────
# CREDIT BUREAU
# ──────────────────────────────────────────────
CREDIT_BUREAU_PROVIDER=mock
TRANSUNION_BASE_URL=
TRANSUNION_API_KEY=
TRANSUNION_API_SECRET=
TRANSUNION_MEMBER_CODE=
TRANSUNION_PRODUCT_CODE=
TRANSUNION_TIMEOUT=30
CREDIT_REPORT_VALIDITY_DAYS=30

# ──────────────────────────────────────────────
# AWS S3 (document storage)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=wethu-documents
AWS_S3_REGION_NAME=af-south-1
AWS_S3_ENDPOINT_URL=

# ──────────────────────────────────────────────
# SENTRY
# ──────────────────────────────────────────────
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1



