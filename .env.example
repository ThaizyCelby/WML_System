# --------------------------------------------------------------
# AI PROVIDERS
# --------------------------------------------------------------
# GLM is the primary and default AI provider.
# Gemini and OpenAI are kept as optional emergency fallbacks.
#AI_DEFAULT_PROVIDER=glm
#AI_FALLBACK_TO_MOCK=true

# GLM (Z.AI international endpoint — free tier available)
#GLM_ENABLED=true
#GLM_API_KEY=
#GLM_MODEL=glm-5.3-flash
#GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Gemini (disabled by default — enable only if you have a valid AIza... key)
#GEMINI_ENABLED=false
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash

# OpenAI (disabled by default — requires paid credits)
#OPENAI_ENABLED=false
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

